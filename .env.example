# ── Required in production ────────────────────────────────────────────────
# 32+ random characters; used to sign session cookies (HS256).
AUTH_SECRET=

# Public origin of the deployment (no trailing slash). Used for canonical URLs,
# sitemap, Open Graph and JSON-LD. NEXT_PUBLIC_SITE_URL is inlined at build time;
# SITE_URL is read at runtime on the server and overrides it (handy for Docker).
NEXT_PUBLIC_SITE_URL=https://mitesla-atelier.com
SITE_URL=

# ── Persistence (recommended in production) ──────────────────────────────
# Upstash Redis REST credentials. When both are set, users, orders, bookings,
# garage vehicles and shared keys are persisted; otherwise an in-memory store
# is used (fine for local development and previews).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────
# ICP 备案号 / 公安备案号 shown in the footer for mainland China deployments.
# (ICP_LICENSE / PSB_LICENSE are runtime equivalents that take precedence.)
NEXT_PUBLIC_ICP=
NEXT_PUBLIC_PSB=
ICP_LICENSE=
PSB_LICENSE=
# Version label surfaced by /api/health (only to requests carrying x-health-token: $HEALTH_TOKEN).
NEXT_PUBLIC_APP_VERSION=1.0.0
HEALTH_TOKEN=
# Set to "true" only to knowingly run production on the volatile in-memory store
# (otherwise production refuses to start without Upstash credentials).
ALLOW_MEMORY_STORE=
# Set to "true" only to run a production build without AUTH_SECRET (not recommended).
ALLOW_INSECURE_AUTH_SECRET=
# Set to "true" when serving production over plain HTTP without a TLS proxy
# (disables HSTS, CSP upgrade-insecure-requests and the Secure cookie flag).
ALLOW_INSECURE_HTTP=
